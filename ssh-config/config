# ── Global Defaults ──────────────────────────────────────────
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    StrictHostKeyChecking ask


# ── Personal Home Server: ────────────────────────────────────
Host homelab
    HostName 192.168.0.23
    User luke
    IdentityFile ~/.ssh/id_ed25519
    Port 22


