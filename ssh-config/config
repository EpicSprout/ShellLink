#
# This file is synced via ShellLink. Edit it here and re-run
# bootstrap to push changes to all your machines.
#
# Tip: Add host entries below. ShellLink will symlink this
# to ~/.ssh/config automatically.

# ── Global Defaults ──────────────────────────────────────────
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    StrictHostKeyChecking ask

# ── Example: Personal Server ─────────────────────────────────
# Host myserver
#     HostName 192.168.1.100
#     User youruser
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22

# ── Example: GitHub ──────────────────────────────────────────
# Host github.com
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519

# ── Example: Work Jumpbox ────────────────────────────────────
# Host jumpbox
#     HostName jump.example.com
#     User admin
#     IdentityFile ~/.ssh/id_ed25519
#     ProxyJump none
#
# Host internal-server
#     HostName 10.0.0.5
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519
#     ProxyJump jumpbox
