# ShellLink SSH Config — Environment Variables
# Copy this file to .env and fill in your real values.
# .env is gitignored and will NOT be committed.
#
# Define hosts using: HOST_<alias>_<PROPERTY>=value
# Properties: HOSTNAME (required), USER, PORT, IDENTITY_FILE, LABEL
# Defaults if omitted: PORT=22, IDENTITY_FILE=~/.ssh/id_ed25519
#
# To add a new server, just add a new HOST_<alias>_ block.

HOST_myserver_LABEL=Example Server
HOST_myserver_HOSTNAME=x.x.x.x
HOST_myserver_USER=your-username
HOST_myserver_PORT=22
HOST_myserver_IDENTITY_FILE=~/.ssh/id_ed25519
