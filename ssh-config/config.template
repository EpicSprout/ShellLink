# This file is a template. Host entries are generated automatically
# from ssh-config/.env at bootstrap time.
# To add a new server, add a HOST_<alias>_ block in .env.


# ── Global Defaults ──────────────────────────────────────────
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    StrictHostKeyChecking ask
